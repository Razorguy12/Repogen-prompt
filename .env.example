# Copy this file to .env and fill in your values
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://repogen:change_me@localhost:5432/repogen
SECRET_KEY=replace_with_a_long_random_secret
# Production path; create it and grant write access to the repogen systemd user.
AUDIT_LOG_DIR=/var/log/repogen
# Set only to the actual Nginx peer address(es); leave empty to ignore X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Root admin bootstrap: only used when the account does not exist yet.
ROOT_ADMIN_USERNAME=
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_NAME=
ROOT_ADMIN_EMAIL=
# Per-request prompt trimming (drops irrelevant glossary entries / exam templates). 0 = send full prompt.
REPORT_PROMPT_TRIM=1
# Report generation. REPORT_ENGINE=legacy rolls back to the previous prompt and settings.
REPORT_ENGINE=v2
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.15
LLM_MAX_COMPLETION_TOKENS=6000
LLM_REASONING_EFFORT=medium
